#!/bin/sh
# Same file/seconds/PNG contract as the macOS AVFoundation helper.
set -eu
[ "$#" -eq 3 ] || { echo 'Expected input seconds output' >&2; exit 1; }
duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$1")
awk -v time="$2" -v duration="$duration" 'BEGIN {
    if (time !~ /^[0-9]+([.][0-9]+)?$/ || duration !~ /^[0-9]+([.][0-9]+)?$/ || time < 0 || time >= duration) exit 1;
}' || { echo 'Frame time is outside the video duration' >&2; exit 1; }
exec ffmpeg -hide_banner -loglevel error -n -i "$1" -ss "$2" -frames:v 1 -update 1 "$3"
